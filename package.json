{
  "name": "@viramoon/frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/verify-boundaries.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:client": "bash scripts/gen-web-client.sh from-snapshot",
    "check:client": "bash scripts/gen-web-client.sh --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "27.1.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.2.2",
    "vitest": "4.0.8"
  }
}
